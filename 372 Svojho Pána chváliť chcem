<?xml version="1.0" encoding="UTF-8"?>
<song>
  <title>Svojho Pána chváliť chcem</title>
  <hymn_number>372</hymn_number>
  <presentation>V1 V2 V1</presentation>
  <lyrics>[V1]
 Svojho Pána chváliť chcem,
 svojho Pána chváliť chcem.
 Jeho menu sláva večná buď!
 Svojho Pána chváliť chcem.
[V2]
 Vďaku svojmu Pánu vzdám,
 vďaku svojmu Pánu vzdám.
 Jeho menu sláva večná buď!
 Vďaku svojmu Pánu vzdám.</lyrics>
</song>
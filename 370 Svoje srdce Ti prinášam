<?xml version="1.0" encoding="UTF-8"?>
<song>
  <title>Svoje srdce Ti prinášam</title>
  <hymn_number>370</hymn_number>
  <presentation>C V1 C V2 B C</presentation>
  <lyrics>[C]
 Svoje srdce Ti prinášam,
 srdce prinášam.
 Svoje srdce Ti prinášam,
 vládni v ňom sám.
[V1]
 (dievčatá)
 Som nájdená, len Tvoja,
 milovaná, očistená.
 Tvoj život mám, dych si mi dal,
 som uzdravená a slobodná.
[V2]
 (chlapci)
 Som nájdený, Tvoj celý,
 milovaný a očistený.
 Tvoj život mám, dych si mi dal,
 som uzdravený a slobodný.
[B]
 Boh silný, všemocný,
 dobrotivý a nekonečný.
 Si životom a pravdou sám,
 svetlom si, svietiš tmám.</lyrics>
</song>